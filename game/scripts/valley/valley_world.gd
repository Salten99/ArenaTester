class_name ValleyWorld
extends Node3D
## Builds the 3D valley from a ValleyTerrain and the run state: sky and light,
## the ground (low-poly mesh tiles with vertex colors, plus their collision),
## water, the mountain edge, plants and rocks, and the village buildings.
## Everything is made in code; plants, rocks and village models come from
## models/gen/world (generated by tools/blender/make_trees.py and make_props.py). Villagers and warriors are
## added by the Village nodes (village.gd).

const NATURE := "res://models/gen/world/"
const VILLAGE := "res://models/gen/world/"
## Ground mesh cell size in meters (smaller = smoother and slower to build).
const CELL := 6.0
## The ground is split into tiles of this many cells, so off-screen tiles aren't drawn.
const TILE := 40
## Plants are scattered on a jittered grid this many meters apart.
## (7 m felt bare in the first playtest, 2026-10-26.)
const PLANT_SPACING := 5.0
## Trees and bushes gather in groves with clearings between them: a slow noise
## scales their density from GROVES.x (clearing) to GROVES.y (thick grove).
const GROVES := Vector2(0.35, 1.65)
## Plants are grouped in square chunks this many meters wide; each chunk is drawn
## only within its view distance (small plants vanish sooner, hidden by fog anyway).
const PLANT_CHUNK := 250.0
## Biomes with at least this much grass `cover` get the user's grass tile as a carpet near you
## (GrassField), and no grass tufts on top of it (they stood out, 2026-11-10).
const CARPET_COVER := 0.5
## Grass blades on or off: the carpet near you (GrassField) and the scattered tufts. Off for now
## (user, 2026-11-11: only the ground texture); true brings them all back.
const BLADES := false
const PLANT_REACH := 200.0  ## plant colliders exist this far around the player's chunk
const VIEW_SMALL := 220.0
const VIEW_WALLS := 500.0
const VIEW_TREES := 900.0
const VILLAGE_SCALE := 3.2
## Giant trees in a biome with "giants" (the Ancient forest, user 2026-11-08): this share of its
## ancient trees stand GIANT_HEIGHT m tall, GIANT_WIDTH times as wide as the model.
const GIANT_HEIGHT := Vector2(45.0, 55.0)
const GIANT_WIDTH := Vector2(3.0, 4.0)
const ANCIENT_HEIGHT := 6.0  ## the Tree_Ancient models' height at scale 1 (make_trees.py)
## Houses and halls 35% bigger (user, 2026-11-05); walls, gates and towers stay as they are.
const BUILDING_GROWTH := 1.35

const TREES := {
	"leafy": ["Tree_Oak_A", "Tree_Oak_B", "Tree_Oak_C", "Tree_Birch_A", "Tree_Birch_B", "Tree_Blossom_A", "Tree_Blossom_B", "Tree_Blossom_C", "Tree_Willow_A"],
	"ancient": ["Tree_Ancient_A", "Tree_Ancient_B", "Tree_Ancient_C", "Tree_Oak_B", "Tree_Oak_C"],
	"savanna": ["Tree_Acacia_A", "Tree_Acacia_B", "Tree_Acacia_C", "Tree_Oak_A"],
	"pine": ["Tree_Pine_A", "Tree_Pine_B", "Tree_Pine_C", "Tree_Dead_A"],
	"alpine": ["Tree_Alpine_A", "Tree_Alpine_B", "Tree_Alpine_C", "Tree_Pine_B"],
	"snow": ["Tree_SnowPine_A", "Tree_SnowPine_B", "Tree_SnowPine_C", "Tree_Alpine_A"],
	"jungle": ["Tree_Kapok_A", "Tree_Kapok_B", "Tree_Kapok_C", "Tree_Kapok_A", "Tree_Palm_A", "Tree_Palm_B", "Tree_Palm_C", "Tree_Banana_A", "Tree_Banana_B", "Tree_Banana_C"],
	"swamp": ["Tree_Willow_A", "Tree_Willow_B", "Tree_Willow_C", "Tree_Cypress_A", "Tree_Cypress_B", "Tree_Cypress_C", "Tree_Dead_B"],
	"desert": ["Tree_Saguaro_A", "Tree_Saguaro_B", "Tree_Saguaro_C", "Tree_Joshua_A", "Tree_Joshua_B", "Tree_Joshua_C", "Tree_Dead_C"],
	"charred": ["Tree_Charred_A", "Tree_Charred_B", "Tree_Charred_C"],
	"bare": ["Tree_Dead_A", "Tree_Dead_B", "Tree_Dead_C", "Tree_Birch_C"],
}
const ROCKS := ["rock_a", "rock_b", "rock_c", "rock_d"]
const BUSHES := ["bush_a", "bush_b", "bush_c"]
const GRASS := ["grass_a", "grass_b"]
## Grass sets by biome turf (ValleyTerrain.BIOMES): "meadow" is the user's own
## grass (grass.blend via tools/blender/make_grass_from_blend.py), in the green biomes.
const TURF := {"meadow": ["grass_meadow_a", "grass_meadow_b"]}
## Scale range of the scattered grass: the user's grass is kept short (about
## 20-30 cm, user 2026-10-29); the generated tufts keep their old size.
const TURF_SCALE := {"meadow": Vector2(1.0, 1.5)}
const TUFT_SCALE := Vector2(1.8, 2.8)
## Your own world models (same file names) win over the generated ones.
const OWN_NATURE := "res://models/own/world/"
const HOUSES := ["house_large", "house_porch", "hut", "barracks"]
const GROUP_TYPES := ["hall", "row", "compound", "court"]  ## make_race_buildings.py GROUPS
const OUTER_DEFAULT := ["human_hall", "human_row", "human_compound", "human_court"]  ## a tribe with no kit of its own
const INNER_RING := 20.0  ## meters from the village's center: its houses and landmark
const MIDDLE_RING := 32.0  ## a street of more houses
const OUTER_RING := 46.0  ## its bigger buildings
const YARD_RING := 60.0  ## fields, pens and yards, inside the walls
const WALL_RING := 70.0
const GATE_RING := 65.0  ## where a gate's guard stands
const WALL_STEP := 20.0  ## a wall section's length (make_village_parts.py)
const ROADS := 3  ## main roads from the square out to the gates
const YARD := ["field_grain", "pen", "garden", "field_greens", "woodpile", "pen", "drying_rack", "field_grain", "garden", "woodpile", "field_greens", "pen"]
const ROAD_COLOR := Color(0.42, 0.34, 0.25)
const SQUARE_COLOR := Color(0.52, 0.48, 0.41)
const CLUTTER := ["barrel", "crate", "hay", "cart", "market_stand", "well"]

var terrain: ValleyTerrain
var state: RunState
## Collision shapes for trees, rocks and buildings share one static body.
var _solid: StaticBody3D
var _tiles: Array = []  # MeshInstance3D per ground tile
var _nx := 0
var _nz := 0
var _heights := PackedFloat32Array()
var _colors := PackedColorArray()
var _rng := RandomNumberGenerator.new()
var _ground_mat: ShaderMaterial
const GROUND_SHADER := preload("res://shaders/ground.gdshader")
## The user's grass picture (rendered from grass.blend, 2026-11-11), on the ground of the grassy biomes.
const GRASS_TEXTURE := preload("res://textures/grass.png")
## The user's stone picture (2026-11-17) on the Old Towers, over each region's stone color.
const STONE_TEXTURE := preload("res://textures/stone_masonry.png")
## Meters of wall one copy of the stone picture covers.
const STONE_TILE := 3.0


## True once build() has run (the loading screen builds the world before it enters the scene).
var built := false


func _ready() -> void:
	if not built:
		build()
	var t := Timer.new()
	t.wait_time = 0.5
	t.autostart = true
	t.timeout.connect(_stream_plants)
	add_child(t)


## Tree and rock colliders only in the plant chunks near the player: hundreds of thousands of
## shapes across the valley made loading and physics slow.
func _stream_plants() -> void:
	if not is_inside_tree():
		return  # the loading screen builds the world first; the timer below streams them once it's in the scene
	var p := get_tree().get_first_node_in_group("player") as Node3D
	if p != null and not p.is_inside_tree():
		p = null
	for key: Vector2i in _plant_bodies:
		var body: StaticBody3D = _plant_bodies[key]
		var near := p != null and Rect2(Vector2(key) * PLANT_CHUNK, Vector2.ONE * PLANT_CHUNK).grow(PLANT_REACH).has_point(Vector2(p.global_position.x, p.global_position.z))
		if near and not body.is_inside_tree():
			add_child(body)
		elif not near and body.is_inside_tree():
			remove_child(body)


func _notification(what: int) -> void:
	if what == NOTIFICATION_PREDELETE:
		for body: StaticBody3D in _plant_bodies.values():
			if not body.is_inside_tree():
				body.free()  # the ones far away aren't in the scene, so nothing else frees them


## Builds everything. `report` (optional, LoadingScreen.report) is awaited between
## slices of work with (progress 0-1, step) so a loading screen can redraw; without
## it the build runs in one go.
func build(report := Callable()) -> void:
	_rng.seed = state.seed + 99
	_solid = StaticBody3D.new()
	_solid.collision_layer = 0b001
	add_child(_solid)
	_build_environment()
	terrain.build_roads(state)
	await _report(report, 0.02, "Shaping the land")
	await _build_ground(report)
	_build_roads()
	await _report(report, 0.45, "Filling the rivers and lakes")
	_build_water()
	_build_bridges()
	_build_landmarks()
	_build_sky_islands()
	_build_edge()
	await _report(report, 0.5, "Planting the forests")
	await _scatter_plants(report)
	built = true


func _report(report: Callable, fraction: float, step := ""):
	if report.is_valid():
		await report.call(fraction, step)


## Re-colors the ground after `region` falls to the evil tribe: only the ground
## within its reach is recomputed (all of it if no region is given).
func recolor(region := "") -> void:
	var corrupted := _corrupted()
	var center := ValleyTerrain.region_center(region) if region != "" else Vector2.ZERO
	var reach := 4.0 * ValleyTerrain.BLEND + CELL * TILE
	var n := _nx + 1
	var i := 0
	for tz in range(0, _nz, TILE):
		for tx in range(0, _nx, TILE):
			var mid := _grid_point(tx + TILE / 2, tz + TILE / 2)
			if region == "" or mid.distance_to(center) < reach + CELL * TILE:
				for iz in range(tz, mini(tz + TILE, _nz) + 1):
					for ix in range(tx, mini(tx + TILE, _nx) + 1):
						var p := _grid_point(ix, iz)
						_colors[iz * n + ix] = ground_color(p.x, p.y, _heights[iz * n + ix], corrupted)
				(_tiles[i] as MeshInstance3D).mesh = _tile_mesh(tx, tz, _colors)
			i += 1


func _corrupted() -> Array:
	return state.regions.keys().filter(func(r): return state.regions[r].get("corrupted", false))


# ---------------------------------------------------------------- sky, ground, water

func _build_environment() -> void:
	var env := WorldEnvironment.new()
	var e := Environment.new()
	var sky := Sky.new()
	var sky_mat := ProceduralSkyMaterial.new()
	sky_mat.sky_top_color = Color(0.3, 0.48, 0.78)
	sky_mat.sky_horizon_color = Color(0.78, 0.74, 0.66)
	sky_mat.ground_horizon_color = Color(0.5, 0.47, 0.42)
	sky.sky_material = sky_mat
	e.background_mode = Environment.BG_SKY
	e.sky = sky
	e.ambient_light_source = Environment.AMBIENT_SOURCE_SKY
	e.ambient_light_energy = 0.9
	e.tonemap_mode = Environment.TONE_MAPPER_LINEAR  # Retro look: plain colors, no film curve
	_ps2_glow(e)
	e.fog_enabled = true
	e.fog_light_color = Color(0.72, 0.74, 0.78)
	e.fog_density = 0.004  # Retro look: close fog (was 0.0016); lower to see farther
	e.fog_aerial_perspective = 0.5
	env.environment = e
	add_child(env)
	var sun := DirectionalLight3D.new()
	sun.rotation_degrees = Vector3(-50, -40, 0)
	sun.light_energy = 1.25
	# Retro look: no sun shadows; creatures get a dark disc (CharacterModel.add_blob_shadow)
	add_child(sun)


## Retro look, PS2 style: bright things bleed a soft glow, as PS2 games did.
static func _ps2_glow(e: Environment) -> void:
	e.glow_enabled = true
	e.glow_intensity = 0.6
	e.glow_bloom = 0.08
	e.glow_hdr_threshold = 0.85
	e.glow_blend_mode = Environment.GLOW_BLEND_MODE_SOFTLIGHT


func _build_ground(report := Callable()) -> void:
	_nx = int(ceil((ValleyTerrain.HALF_W + ValleyTerrain.MARGIN) * 2.0 / CELL))
	_nz = int(ceil((ValleyTerrain.HALF_L + ValleyTerrain.MARGIN) * 2.0 / CELL))
	# Rows are independent (the terrain is only read), so every CPU core takes some.
	var corrupted := _corrupted()
	var rows: Array = []
	rows.resize(_nz + 1)  # sized up front: threads may set different elements, never resize
	var task := WorkerThreadPool.add_group_task(func(iz: int): rows[iz] = _ground_row(iz, corrupted), _nz + 1)
	while report.is_valid() and not WorkerThreadPool.is_group_task_completed(task):
		await _report(report, 0.02 + 0.38 * WorkerThreadPool.get_group_processed_element_count(task) / (_nz + 1))
	WorkerThreadPool.wait_for_group_task_completion(task)
	_heights = PackedFloat32Array()
	_colors = PackedColorArray()
	for r in rows:
		_heights.append_array(r[0])
		_colors.append_array(r[1])
	_ground_mat = ShaderMaterial.new()
	_ground_mat.shader = GROUND_SHADER
	_ground_mat.set_shader_parameter("grit", RetroLook.grit())
	_ground_mat.set_shader_parameter("grit_size", RetroLook.GRIT_SIZE * RetroLook.GRIT_TEXEL)
	_ground_mat.set_shader_parameter("grass", GRASS_TEXTURE)
	# The picture shades each biome's own color (as bright as the grit does) instead of replacing it.
	var grit_avg := _average(RetroLook.grit().get_image())
	var grass_avg := _average(GRASS_TEXTURE.get_image())
	_ground_mat.set_shader_parameter("grass_gain", Vector3(grit_avg.r / grass_avg.r, grit_avg.g / grass_avg.g, grit_avg.b / grass_avg.b))
	var body := StaticBody3D.new()
	body.name = "GroundBody"
	body.collision_layer = 0b001
	for tz in range(0, _nz, TILE):
		for tx in range(0, _nx, TILE):
			var tile := MeshInstance3D.new()
			tile.name = "Ground_%d_%d" % [tx, tz]
			tile.mesh = _tile_mesh(tx, tz, _colors)
			tile.material_override = _ground_mat
			add_child(tile)
			_tiles.append(tile)
			var shape := CollisionShape3D.new()
			var faces := ConcavePolygonShape3D.new()
			faces.set_faces(tile.mesh.surface_get_arrays(0)[Mesh.ARRAY_VERTEX])
			faces.backface_collision = true
			shape.shape = faces
			body.add_child(shape)
	add_child(body)  # after its shapes: adding shapes to a body already in the scene rebuilds it each time


## One row of the ground grid: [heights, colors]. Runs on worker threads, so it only reads.
func _ground_row(iz: int, corrupted: Array) -> Array:
	var hs := PackedFloat32Array()
	var cs := PackedColorArray()
	hs.resize(_nx + 1)
	cs.resize(_nx + 1)
	for ix in _nx + 1:
		var p := _grid_point(ix, iz)
		var ws := terrain.weights_at(p.x, p.y)
		var h := terrain.height(p.x, p.y, ws)
		hs[ix] = h
		cs[ix] = ground_color(p.x, p.y, h, corrupted, ws)
	return [hs, cs]


## The ground's color at a point: the terrain's, or road dirt where a road runs (user, 2026-11-05:
## roads are just the ground colored along the way, at its own level).
func ground_color(x: float, z: float, h: float, corrupted: Array, ws: Array = []) -> Color:
	var c := terrain.color(x, z, h, corrupted, ws) if not ws.is_empty() else terrain.color(x, z, h, corrupted)
	return c.lerp(ROAD_COLOR, 0.85) if terrain.near_road(x, z, 1.0) else c


## An image's average color, linear (as the shader sees an sRGB texture).
static func _average(img: Image) -> Color:
	if img.is_compressed():
		img.decompress()
	var sum := Color(0, 0, 0)
	for y in img.get_height():
		for x in img.get_width():
			sum += img.get_pixel(x, y).srgb_to_linear()
	return sum / float(img.get_width() * img.get_height())


func _grid_point(ix: int, iz: int) -> Vector2:
	return Vector2(-ValleyTerrain.HALF_W - ValleyTerrain.MARGIN + ix * CELL, -ValleyTerrain.HALF_L - ValleyTerrain.MARGIN + iz * CELL)


## One tile of flat-shaded triangles (the low-poly look), each with one color.
func _tile_mesh(tx: int, tz: int, colors: PackedColorArray) -> ArrayMesh:
	var n := _nx + 1
	var verts := PackedVector3Array()
	var normals := PackedVector3Array()
	var cols := PackedColorArray()
	for iz in range(tz, mini(tz + TILE, _nz)):
		for ix in range(tx, mini(tx + TILE, _nx)):
			var a := iz * n + ix
			var b := a + 1
			var c := a + n
			var d := c + 1
			_tri(verts, normals, cols, colors, a, b, c, n)
			_tri(verts, normals, cols, colors, b, d, c, n)
	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = verts
	arrays[Mesh.ARRAY_NORMAL] = normals
	arrays[Mesh.ARRAY_COLOR] = cols
	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	return mesh


func _tri(verts: PackedVector3Array, normals: PackedVector3Array, cols: PackedColorArray, colors: PackedColorArray, i0: int, i1: int, i2: int, n: int) -> void:
	var g0 := _grid_point(i0 % n, i0 / n)
	var g1 := _grid_point(i1 % n, i1 / n)
	var g2 := _grid_point(i2 % n, i2 / n)
	var p0 := Vector3(g0.x, _heights[i0], g0.y)
	var p1 := Vector3(g1.x, _heights[i1], g1.y)
	var p2 := Vector3(g2.x, _heights[i2], g2.y)
	var normal := (p2 - p0).cross(p1 - p0).normalized()
	var col := (colors[i0] + colors[i1] + colors[i2]) / 3.0
	verts.append_array([p0, p1, p2])
	normals.append_array([normal, normal, normal])
	cols.append_array([col, col, col])


func _build_water() -> void:
	var water := MeshInstance3D.new()
	var plane := PlaneMesh.new()
	plane.size = Vector2(ValleyTerrain.HALF_W * 2.0, ValleyTerrain.HALF_L * 2.0)
	water.mesh = plane
	var mat := StandardMaterial3D.new()
	mat.albedo_color = Color(0.22, 0.42, 0.5, 0.75)
	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	mat.roughness = 0.15
	mat.metallic_specular = 0.8
	water.material_override = mat
	water.position.y = ValleyTerrain.WATER_Y
	water.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	add_child(water)
	_build_rapids()
	_build_lakes()
	_build_waterfalls()


## Flowing water: stripes that scroll along the surface (rapids, waterfalls).
const WATER_SHADER := """
shader_type spatial;
render_mode cull_disabled, depth_draw_opaque;
uniform vec4 tint : source_color = vec4(0.2, 0.4, 0.5, 0.8);
uniform float speed = 1.0;
uniform float stripes = 30.0;
void fragment() {
	float s = sin(UV.y * stripes - TIME * speed * 6.0 + sin(UV.x * 12.0) * 1.5) * 0.5 + 0.5;
	ALBEDO = tint.rgb + vec3(s * s * 0.35);
	ALPHA = tint.a;
	ROUGHNESS = 0.15;
}
"""


func _flowing(tint: Color, speed: float, stripes: float) -> ShaderMaterial:
	var shader := Shader.new()
	shader.code = WATER_SHADER
	var mat := ShaderMaterial.new()
	mat.shader = shader
	mat.set_shader_parameter("tint", tint)
	mat.set_shader_parameter("speed", speed)
	mat.set_shader_parameter("stripes", stripes)
	return mat


## The rapids get their own dark, fast-flowing surface over the river.
func _build_rapids() -> void:
	for i in terrain.rivers.size():
		if not terrain.rivers[i].rapids:
			continue
		var line := terrain.river_line(i)
		var st := SurfaceTool.new()
		st.begin(Mesh.PRIMITIVE_TRIANGLES)
		var y := ValleyTerrain.WATER_Y + 0.04
		for k in line.size() - 1:
			var w0: float = terrain.rivers[i].width[k] * 0.5 + ValleyTerrain.RIVER_BANK * 0.6
			var w1: float = terrain.rivers[i].width[k + 1] * 0.5 + ValleyTerrain.RIVER_BANK * 0.6
			var a := line[k]
			var b := line[k + 1]
			var n := (b - a).normalized().orthogonal()  # across the river
			var a0 := a - n * w0
			var a1 := a + n * w0
			var b0 := b - n * w1
			var b1 := b + n * w1
			var u0 := float(k) / line.size()
			var u1 := float(k + 1) / line.size()
			var quad := [[Vector3(a0.x, y, a0.y), Vector2(0, u0)], [Vector3(b0.x, y, b0.y), Vector2(0, u1)], [Vector3(a1.x, y, a1.y), Vector2(1, u0)],
				[Vector3(b0.x, y, b0.y), Vector2(0, u1)], [Vector3(b1.x, y, b1.y), Vector2(1, u1)], [Vector3(a1.x, y, a1.y), Vector2(1, u0)]]
			for v in quad:
				st.set_normal(Vector3.UP)
				st.set_uv(Vector2(v[1].x, v[1].y * 60.0))
				st.add_vertex(v[0])
		var mesh := MeshInstance3D.new()
		mesh.name = "Rapids"
		mesh.mesh = st.commit()
		mesh.material_override = _flowing(Color(0.06, 0.12, 0.16, 0.92), 2.5, 6.0)
		mesh.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		add_child(mesh)


## Lakes: a flat disc at each lake's surface. Deep lakes (Frogfolk only) are dark.
func _build_lakes() -> void:
	for lake in terrain.lakes:
		if lake.fed:
			continue  # at river level: the valley's water plane already covers it
		var disc := MeshInstance3D.new()
		disc.name = "DeepLake" if lake.deep else "Lake"
		var cyl := CylinderMesh.new()
		cyl.top_radius = ValleyTerrain.lake_reach(lake) + ValleyTerrain.LAKE_BANK
		cyl.bottom_radius = cyl.top_radius
		cyl.height = 0.02
		cyl.radial_segments = 40
		disc.mesh = cyl
		var mat := StandardMaterial3D.new()
		mat.albedo_color = Color(0.05, 0.1, 0.18, 0.92) if lake.deep else Color(0.22, 0.45, 0.55, 0.78)
		mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
		mat.roughness = 0.1
		disc.material_override = mat
		disc.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		disc.position = Vector3(lake.pos.x, lake.surface, lake.pos.y)
		add_child(disc)


## Waterfalls where the rivers pour out of the mountains: a falling sheet of
## water and spray where it lands.
func _build_waterfalls() -> void:
	for f in terrain.waterfalls:
		var top: Vector3 = f.top
		var bottom: Vector3 = f.bottom
		var width: float = f.width * 0.5 + 6.0
		var st := SurfaceTool.new()
		st.begin(Mesh.PRIMITIVE_TRIANGLES)
		var across: Vector2 = (f.dir as Vector2).orthogonal()
		var side := Vector3(across.x, 0, across.y) * width * 0.5
		var corners := [[top - side, Vector2(0, 0)], [bottom - side, Vector2(0, 1)], [top + side, Vector2(1, 0)],
			[bottom - side, Vector2(0, 1)], [bottom + side, Vector2(1, 1)], [top + side, Vector2(1, 0)]]
		for c in corners:
			st.set_normal((bottom - top).cross(side).normalized())
			st.set_uv(c[1])
			st.add_vertex(c[0])
		var sheet := MeshInstance3D.new()
		sheet.name = "Waterfall"
		sheet.mesh = st.commit()
		var rapids: bool = terrain.rivers[f.river].rapids
		sheet.material_override = _flowing(Color(0.75, 0.85, 0.9, 0.7) if not rapids else Color(0.35, 0.42, 0.45, 0.8), -3.0, 14.0)
		sheet.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		add_child(sheet)
		var spray := CPUParticles3D.new()
		spray.name = "Spray"
		spray.amount = 60
		spray.lifetime = 1.4
		spray.emission_shape = CPUParticles3D.EMISSION_SHAPE_BOX
		spray.emission_box_extents = Vector3(2.0, 0.3, width * 0.5)
		spray.rotation.y = -atan2(f.dir.y, f.dir.x)
		spray.direction = Vector3.UP
		spray.spread = 40.0
		spray.initial_velocity_min = 2.0
		spray.initial_velocity_max = 5.0
		spray.gravity = Vector3(0, -4.0, 0)
		spray.scale_amount_min = 0.6
		spray.scale_amount_max = 1.4
		var puff := SphereMesh.new()
		puff.radius = 0.5
		puff.height = 1.0
		var white := StandardMaterial3D.new()
		white.albedo_color = Color(1, 1, 1, 0.5)
		white.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
		white.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		puff.material = white
		spray.mesh = puff
		spray.position = bottom + Vector3(0, 0.3, 0)
		add_child(spray)


## The big landmarks (ValleyTerrain.landmarks): your model in models/own/world/
## wins, else the generated one; collision from the mesh itself, a sign seen from 150 m.
func _build_landmarks() -> void:
	for l in terrain.landmarks:
		var path: String = OWN_NATURE + l.model + ".glb"
		if not ResourceLoader.exists(path):
			path = VILLAGE + l.model + ".glb"
		if not ResourceLoader.exists(path):
			continue
		var n: Node3D = (load(path) as PackedScene).instantiate()
		n.name = l.model
		add_child(n)
		n.position = Vector3(l.pos.x, l.get("y", terrain.height(l.pos.x, l.pos.y)), l.pos.y)
		n.rotation.y = l.angle
		CharacterModel.use_vertex_colors(n)
		if l.get("kind") == "tower" and not path.begins_with(OWN_NATURE):
			stone(n)
		for m in n.find_children("*", "MeshInstance3D", true, false):
			(m as MeshInstance3D).create_trimesh_collision()
		if l.model == "landmark_castle":
			occlude(n)
		var sign := Label3D.new()
		sign.text = l.name
		sign.billboard = BaseMaterial3D.BILLBOARD_ENABLED
		sign.font_size = 64
		sign.outline_size = 16
		sign.pixel_size = 0.03
		sign.visibility_range_end = 150.0
		sign.position = Vector3.UP * 30.0
		n.add_child(sign)


## Puts the stone picture on a generated model, tinted by its vertex colors (the region's stone).
## shortcut: one material per model, so the tower's door and flag get the stone too; split the
## generator's materials if that shows.
static func stone(n: Node) -> void:
	for m in n.find_children("*", "MeshInstance3D", true, false):
		var mesh: Mesh = (m as MeshInstance3D).mesh
		for i in mesh.get_surface_count():
			var mat := mesh.surface_get_material(i) as BaseMaterial3D
			if mat == null:
				continue
			mat.albedo_texture = STONE_TEXTURE
			mat.albedo_color = Color(2.1, 2.1, 2.1)  # the picture averages ~0.47 bright: keep the stone color as bright as before
			mat.uv1_triplanar = true
			mat.uv1_scale = Vector3.ONE / STONE_TILE


## Floating islands (ValleyTerrain.sky_islands): a grassy top over a hanging cone of rock, and the
## stepping stones spiralling up to it. Generated shapes until you make your own (sky_island.glb,
## sky_stone.glb in models/own/world, built 1 m wide with the top at y 0: scaled to fit).
func _build_sky_islands() -> void:
	var rock := StandardMaterial3D.new()
	rock.albedo_color = Color(0.42, 0.37, 0.33)
	rock.roughness = 1.0
	for s in terrain.sky_islands:
		var top := Vector3(s.pos.x, s.top, s.pos.y)
		var grass := StandardMaterial3D.new()
		grass.albedo_color = terrain.color(s.pos.x, s.pos.y, 5.0)
		grass.roughness = 1.0
		_sky_rock(top, s.radius, minf(s.radius * 0.8, ValleyTerrain.SKY_CLEAR - 6.0), grass, rock, "sky_island")
		for k in s.steps.size():
			_sky_rock(s.steps[k], ValleyTerrain.STEP_RADIUS, 1.6 + float(k % 3) * 0.5, grass, rock, "sky_stone")


## One floating rock: your model if you made it, else a grass disc on a rock cone. Solid either way.
func _sky_rock(top: Vector3, radius: float, depth: float, grass: Material, rock: Material, own: String) -> void:
	var body := StaticBody3D.new()
	body.collision_layer = 0b001
	add_child(body)
	body.position = top
	var path := OWN_NATURE + own + ".glb"
	if ResourceLoader.exists(path):
		var n: Node3D = (load(path) as PackedScene).instantiate()
		n.scale = Vector3(radius * 2.0, radius * 2.0, radius * 2.0)
		body.add_child(n)
		CharacterModel.use_vertex_colors(n)
		for m in n.find_children("*", "MeshInstance3D", true, false):
			(m as MeshInstance3D).create_trimesh_collision()
		return
	var main := depth * (0.7 if radius > 5.0 else 1.0)
	var parts := [[radius, radius, 0.8, -0.4, grass, Vector2.ZERO], [radius * 0.97, radius * 0.12, main, -0.8 - main * 0.5, rock, Vector2.ZERO]]
	if radius > 5.0:  # spikes of rock hanging out under the big one
		for k in 6:
			var d := depth * (0.6 + 0.25 * (k % 3))
			parts.append([radius * 0.28, radius * 0.02, d, -0.8 - d * 0.5, rock, Vector2.from_angle(k * 1.37) * radius * (0.3 + 0.08 * k)])
	for part in parts:
		var cyl := CylinderMesh.new()
		cyl.top_radius = part[0]
		cyl.bottom_radius = part[1]
		cyl.height = part[2]
		cyl.radial_segments = 9
		cyl.rings = 1
		cyl.material = part[4]
		var mesh := MeshInstance3D.new()
		mesh.mesh = cyl
		mesh.position = Vector3(part[5].x, part[3], part[5].y)
		body.add_child(mesh)
		var shape := CollisionShape3D.new()
		shape.shape = cyl.create_convex_shape()
		shape.position = mesh.position
		body.add_child(shape)


## Wooden bridges over the rivers: a sloped deck from bank to bank, railings,
## and posts down to the river bed. Built from boxes until your own model exists.
func _build_bridges() -> void:
	var wood := StandardMaterial3D.new()
	wood.albedo_color = Color(0.45, 0.3, 0.18)
	wood.roughness = 0.9
	var dark := StandardMaterial3D.new()
	dark.albedo_color = Color(0.3, 0.2, 0.12)
	for b in terrain.bridges:
		var a3 := Vector3(b.a.x, terrain.height(b.a.x, b.a.y) + 0.12, b.a.y)
		var b3 := Vector3(b.b.x, terrain.height(b.b.x, b.b.y) + 0.12, b.b.y)
		var root := Node3D.new()
		root.name = "Bridge"
		add_child(root)
		var length := a3.distance_to(b3) + 3.0
		var along := Transform3D(Basis.looking_at(b3 - a3, Vector3.UP), (a3 + b3) * 0.5)
		var w := ValleyTerrain.BRIDGE_WIDTH
		_bridge_box(root, along, Vector3(0, -0.25, 0), Vector3(w, 0.5, length), wood)
		for side in [-1.0, 1.0]:
			_bridge_box(root, along, Vector3(side * (w * 0.5 - 0.1), 0.55, 0), Vector3(0.2, 0.15, length), dark)
			var posts := int(length / 6.0)
			for k in posts + 1:
				var z := -length * 0.5 + k * length / maxf(1.0, posts)
				var top := along * Vector3(side * (w * 0.5 - 0.1), 0.6, z)
				var depth: float = top.y - ValleyTerrain.RIVER_BED + 0.5
				var post := MeshInstance3D.new()
				var box := BoxMesh.new()
				box.size = Vector3(0.3, depth, 0.3)
				post.mesh = box
				post.material_override = dark
				root.add_child(post)
				post.global_transform = Transform3D(Basis(), top - Vector3(0, depth * 0.5, 0))


## One box of a bridge: a mesh plus a matching collider.
func _bridge_box(root: Node3D, along: Transform3D, offset: Vector3, size: Vector3, mat: Material) -> void:
	var xf := along * Transform3D(Basis(), offset)
	var mesh := MeshInstance3D.new()
	var box := BoxMesh.new()
	box.size = size
	mesh.mesh = box
	mesh.material_override = mat
	root.add_child(mesh)
	mesh.global_transform = xf
	var shape := CollisionShape3D.new()
	var bs := BoxShape3D.new()
	bs.size = size
	shape.shape = bs
	shape.transform = xf
	_solid.add_child(shape)


## An invisible wall where the land ends, out past the mountains (playtest 2026-11-08: at the
## valley's edge it stopped you partway up a slope you could still climb).
const EDGE_WALL_Q := ValleyTerrain.EDGE_Q + ValleyTerrain.MARGIN / ValleyTerrain.HALF_W * 0.85


func _build_edge() -> void:
	var segments := 160
	for i in segments:
		var a := ValleyTerrain.edge_point(TAU * i / segments, EDGE_WALL_Q)
		var b := ValleyTerrain.edge_point(TAU * (i + 1) / segments, EDGE_WALL_Q)
		var shape := CollisionShape3D.new()
		var box := BoxShape3D.new()
		box.size = Vector3(a.distance_to(b) + 2.0, 300.0, 2.0)
		shape.shape = box
		var mid := (a + b) * 0.5
		shape.position = Vector3(mid.x, 80.0, mid.y)
		var dir := b - a
		shape.rotation.y = -atan2(dir.y, dir.x)
		_solid.add_child(shape)


# ---------------------------------------------------------------- plants and rocks

func _scatter_plants(report := Callable()) -> void:
	var placed := {}  # "model|chunk" -> [[Transform3D, Color]]
	var groves := FastNoiseLite.new()
	groves.seed = state.seed + 7
	groves.frequency = 0.006
	var steps_x := int(ValleyTerrain.HALF_W * 2.0 / PLANT_SPACING)
	var steps_z := int(ValleyTerrain.HALF_L * 2.0 / PLANT_SPACING)
	for iz in steps_z:
		if iz % 40 == 0:
			await _report(report, 0.5 + 0.45 * iz / steps_z)
		for ix in steps_x:
			var x := -ValleyTerrain.HALF_W + (ix + _rng.randf()) * PLANT_SPACING
			var z := -ValleyTerrain.HALF_L + (iz + _rng.randf()) * PLANT_SPACING
			if ValleyTerrain.shape_q(x, z) > ValleyTerrain.RIM_Q + 0.04 or terrain.near_flat(x, z):
				continue
			var y := _ground_y(x, z)
			if y < ValleyTerrain.WATER_Y + 0.3 or terrain.in_lake(x, z, y) or terrain.near_bridge(x, z, 6.0) or terrain.near_road(x, z, 2.5):
				continue
			var style := terrain.style_at(x, z)
			var tint: Color = style.tint
			var roll := _rng.randf()
			var mix := terrain.style_values(x, z)
			var grove := lerpf(GROVES.x, GROVES.y, groves.get_noise_2d(x, z) * 0.5 + 0.5)
			var trees: float = mix.trees * 0.7 * grove
			var rocks: float = mix.rocks * 0.5
			if roll < trees:
				var model: String = TREES[style.tree][_rng.randi() % TREES[style.tree].size()]
				var s := _rng.randf_range(1.4, 2.1)
				if style.has("giants") and model.begins_with("Tree_Ancient"):
					if _rng.randf() < style.giants:  # a giant, about 50 m tall (user, 2026-11-08)
						s = _rng.randf_range(GIANT_WIDTH.x, GIANT_WIDTH.y)
						var tall := _rng.randf_range(GIANT_HEIGHT.x, GIANT_HEIGHT.y) / ANCIENT_HEIGHT
						_place(placed, model, Vector3(x, y - 0.5, z), s, tint.lerp(Color.WHITE, 0.75), tall / s)
						_collider(Vector3(x, y, z), 0.6 * s, 25.0)
						continue
					model = "Tree_Oak_B"  # the rest of the wood grows under them
				_place(placed, model, Vector3(x, y - 0.2, z), s, tint.lerp(Color.WHITE, 0.75))
				_collider(Vector3(x, y, z), 0.45 * s, 6.0)
			elif roll < trees + rocks:
				var s := _rng.randf_range(1.2, 4.0)
				_place(placed, ROCKS[_rng.randi() % ROCKS.size()], Vector3(x, y - 0.3 * s, z), s, tint)
				if s > 2.2:
					_collider(Vector3(x, y, z), 0.45 * s, 1.0 * s)
			if _rng.randf() < mix.bushes * 0.7 * grove:
				var bx := x + _rng.randf_range(-2.5, 2.5)
				var bz := z + _rng.randf_range(-2.5, 2.5)
				_place(placed, BUSHES[_rng.randi() % BUSHES.size()], Vector3(bx, _ground_y(bx, bz), bz), _rng.randf_range(2.0, 3.2), tint)
			var turf: Array = TURF.get(style.get("turf", ""), GRASS)
			var turf_scale: Vector2 = TURF_SCALE.get(style.get("turf", ""), TUFT_SCALE)
			for k in 2:  # grass tufts
				if _rng.randf() < mix.grass:
					var gx := x + _rng.randf_range(-2.5, 2.5)
					var gz := z + _rng.randf_range(-2.5, 2.5)
					var tuft: String = turf[_rng.randi() % turf.size()]
					var size := _rng.randf_range(turf_scale.x, turf_scale.y)  # drawn before the checks, so the rest of the valley comes out as before
					if not BLADES or ValleyTerrain.shape_q(gx, gz) > ValleyTerrain.RIM_Q or float(style.get("cover", 0.0)) >= CARPET_COVER:
						continue  # no grass past the mountains (user, 2026-11-08); the grass carpet needs no tufts on top
					_place(placed, tuft, Vector3(gx, _ground_y(gx, gz), gz), size, tint)
	for key in placed:
		_multimesh(key, placed[key])
	_stream_plants()


## Ground height from the built ground mesh (much faster than asking the terrain).
func _ground_y(x: float, z: float) -> float:
	var fx := (x + ValleyTerrain.HALF_W + ValleyTerrain.MARGIN) / CELL
	var fz := (z + ValleyTerrain.HALF_L + ValleyTerrain.MARGIN) / CELL
	var ix := clampi(floori(fx), 0, _nx - 1)
	var iz := clampi(floori(fz), 0, _nz - 1)
	var kx := clampf(fx - ix, 0.0, 1.0)
	var kz := clampf(fz - iz, 0.0, 1.0)
	var n := _nx + 1
	var h00 := _heights[iz * n + ix]
	var h10 := _heights[iz * n + ix + 1]
	var h01 := _heights[(iz + 1) * n + ix]
	var h11 := _heights[(iz + 1) * n + ix + 1]
	# The same triangle split as the ground mesh, so plants sit on the visible ground.
	if kx + kz <= 1.0:
		return h00 + (h10 - h00) * kx + (h01 - h00) * kz
	return h11 + (h01 - h11) * (1.0 - kx) + (h10 - h11) * (1.0 - kz)


## `stretch`: this much taller than wide (the giant trees).
func _place(placed: Dictionary, model: String, pos: Vector3, s: float, tint: Color, stretch := 1.0) -> void:
	var basis := Basis(Vector3.UP, _rng.randf() * TAU).scaled(Vector3(s, s * stretch, s))
	var key := "%s|%d|%d" % [model, floori(pos.x / PLANT_CHUNK), floori(pos.z / PLANT_CHUNK)]
	if not placed.has(key):
		placed[key] = []
	placed[key].append([Transform3D(basis, pos), tint])


func _collider(pos: Vector3, radius: float, h: float) -> void:
	var shape := CollisionShape3D.new()
	var cyl := CylinderShape3D.new()
	cyl.radius = radius
	cyl.height = h
	shape.shape = cyl
	shape.position = pos + Vector3.UP * h * 0.5
	# One static body per plant chunk, added to the scene once it's full: adding
	# shapes one by one to a body already in the scene rebuilds it every time.
	var key := Vector2i(floori(pos.x / PLANT_CHUNK), floori(pos.z / PLANT_CHUNK))
	if not _plant_bodies.has(key):
		var body := StaticBody3D.new()
		body.name = "Plants_%d_%d" % [key.x, key.y]
		body.collision_layer = 0b001
		_plant_bodies[key] = body
	_plant_bodies[key].add_child(shape)


var _plant_models := {}  # model -> [Mesh, offset Transform3D, material]
var _plant_bodies := {}  # Vector2i chunk -> StaticBody3D with that chunk's tree and rock colliders


## One MultiMesh per model per chunk: hundreds of plants in a single draw.
## A plant model's [mesh, offset, material] (loaded once), or [] if there is none.
func plant_model(model: String) -> Array:
	if not _plant_models.has(model):
		var path := OWN_NATURE + model + ".glb"
		if not ResourceLoader.exists(path):
			path = NATURE + model + ".glb"
		if not ResourceLoader.exists(path):
			_plant_models[model] = null
		else:
			var src: Node3D = (load(path) as PackedScene).instantiate()
			var found: MeshInstance3D = src.find_children("*", "MeshInstance3D", true, false)[0]
			var m: Mesh = found.mesh
			var material: BaseMaterial3D = m.surface_get_material(0).duplicate() if m.surface_get_material(0) is BaseMaterial3D else StandardMaterial3D.new()
			material.vertex_color_use_as_albedo = true
			if not path.begins_with(OWN_NATURE):
				RetroLook.paint(material)
			_plant_models[model] = [m, local_transform(found, src), material]
			src.free()
	return _plant_models[model] if _plant_models[model] != null else []


func _multimesh(key: String, items: Array) -> void:
	var model := key.get_slice("|", 0)
	var loaded := plant_model(model)
	if loaded.is_empty():
		return
	var mesh: Mesh = loaded[0]
	var offset: Transform3D = loaded[1]
	var mat: BaseMaterial3D = loaded[2]
	var mm := MultiMesh.new()
	mm.transform_format = MultiMesh.TRANSFORM_3D
	mm.use_colors = true
	mm.mesh = mesh
	mm.instance_count = items.size()
	for i in items.size():
		mm.set_instance_transform(i, items[i][0] * offset)
		mm.set_instance_color(i, items[i][1])
	var inst := MultiMeshInstance3D.new()
	inst.name = key.replace("|", "_")
	inst.multimesh = mm
	inst.material_override = mat
	var small := model.begins_with("grass") or model.begins_with("bush")
	if small:
		inst.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	inst.visibility_range_end = VIEW_SMALL if small else VIEW_TREES
	inst.visibility_range_end_margin = 20.0
	add_child(inst)


## `node`'s transform relative to `top` (top's own transform not included).
static func local_transform(node: Node, top: Node) -> Transform3D:
	var t := Transform3D.IDENTITY
	var cur := node
	while cur != null and cur != top:
		if cur is Node3D:
			t = (cur as Node3D).transform * t
		cur = cur.get_parent()
	return t


# ---------------------------------------------------------------- village buildings

## A race's own houses (user, 2026-10-31: each race builds in its culture;
## tools/blender/make_race_buildings.py), else the shared timber set (the humans).
func _kit(race: String) -> Array:
	if ResourceLoader.exists(VILLAGE + race + "_house_a.glb"):
		return [race + "_house_a", race + "_house_b", race + "_house_c"]
	return HOUSES


## A village's buildings around `center`: the race's houses and landmark in a ring,
## a bonfire, clutter and a sign. Returns the root node (villagers are added to it by Village).
func build_village(center: Vector3, is_home: bool, title: String, race := "") -> Node3D:
	var root := Node3D.new()
	root.name = "Village_" + title.replace(" ", "_").replace("'", "")
	add_child(root)
	root.position = center
	var count := 4 if is_home else 6
	var turn := _rng.randf() * TAU
	var houses := _kit(race)
	var roads: Array = terrain.road_angles(Vector2(center.x, center.z))  # the valley's roads come in at gates
	for k in ROADS:
		var a := turn + k * TAU / ROADS + _rng.randf_range(-0.3, 0.3)
		if roads.size() < ROADS and roads.all(func(r): return absf(angle_difference(r, a)) > 0.9):
			roads.append(a)
	# In order around the ring: the gaps between roads (_between_roads, _build_walls) assume it, else walls go
	# round twice and across a road.
	roads = roads.map(func(r): return fposmod(r, TAU))
	roads.sort()
	_build_streets(root, roads)
	# The outer ring (user, 2026-11-01): as many buildings again, of the race's four bigger types.
	var bigger: Array = GROUP_TYPES.map(func(g): return race + "_" + g).filter(func(m): return ResourceLoader.exists(VILLAGE + m + ".glb"))
	if bigger.is_empty():
		bigger = OUTER_DEFAULT
	var outer := count + 3
	for i in count + 2:  # the street between them
		var a := _between_roads(roads, i, count + 2, 0.22)
		_building(root, houses[(i + 1) % houses.size()], Vector3(cos(a), 0.0, sin(a)) * (MIDDLE_RING + _rng.randf_range(-1.5, 1.5)), a, true, VIEW_WALLS)
	for i in outer:
		var a := _between_roads(roads, i, outer, 0.2)
		_building(root, bigger[i % bigger.size()], Vector3(cos(a), 0.0, sin(a)) * (OUTER_RING + _rng.randf_range(-2.0, 2.0)), a, true)
	var landmark := race + "_landmark"
	var slots := count + (1 if ResourceLoader.exists(VILLAGE + landmark + ".glb") else 0)
	for i in slots:
		var a := _between_roads(roads, i, slots, 0.3)
		var model: String = landmark if i == count else houses[(i + int(is_home)) % houses.size()]
		_building(root, model, Vector3(cos(a), 0.0, sin(a)) * (INNER_RING + _rng.randf_range(-1.5, 1.5)), a, true)
	_building(root, "bonfire", Vector3.ZERO, 0.0, false)
	var spots := {"market": [], "yard": [], "pens": [], "gates": []}
	# The square: a market around the fire, the well to one side.
	for i in 6:
		var a := turn + TAU * (i + 0.5) / 6.0
		var at := Vector3(cos(a), 0.0, sin(a)) * 11.0
		_building(root, "market_stand" if i % 2 == 0 else CLUTTER[_rng.randi() % CLUTTER.size()], at, a, false)
		spots.market.append(at * 0.75)
	# Farm land between the houses and the walls.
	for i in YARD.size():
		var a := _between_roads(roads, i, YARD.size(), 0.16)
		var at := Vector3(cos(a), 0.0, sin(a)) * YARD_RING
		_building(root, YARD[i], at, a, false, VIEW_SMALL)
		spots["pens" if YARD[i] == "pen" else "yard"].append(at)
	_build_walls(root, center, race, roads, spots)
	root.set_meta("spots", spots)
	var fire := OmniLight3D.new()
	fire.name = "Fire"
	fire.light_color = Color(1.0, 0.6, 0.3)
	fire.light_energy = 3.0
	fire.omni_range = 16.0
	fire.position = Vector3.UP * 1.5
	root.add_child(fire)
	var sign := Label3D.new()
	sign.name = "Sign"
	sign.text = title
	sign.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	sign.font_size = 72
	sign.outline_size = 18
	sign.pixel_size = 0.02
	sign.modulate = Color(1.0, 0.85, 0.4) if is_home else Color(1, 1, 1)
	sign.position = Vector3.UP * 16.0
	root.add_child(sign)
	return root


## The angle of the `i`th of `count` things spaced evenly around the village, keeping `margin`
## radians clear on each side of every road.
func _between_roads(roads: Array, i: int, count: int, margin: float) -> float:
	var s: float = (i + 0.5) * roads.size() / float(count)
	var k: int = int(s)
	var start: float = roads[k]
	var width: float = fposmod(float(roads[(k + 1) % roads.size()]) - start, TAU)
	return start + margin + (s - k) * (width - 2.0 * margin)


## The walls, with a gate where each road leaves, two towers beside it, and an opening in every
## few sections: units have no pathfinding, so nobody may get walled out.
func _build_walls(root: Node3D, center: Vector3, race: String, roads: Array, spots: Dictionary) -> void:
	var style := race if ResourceLoader.exists(VILLAGE + race + "_wall.glb") else "human"
	var dry := func(a: float) -> bool:
		return terrain.water_surface(center.x + cos(a) * WALL_RING, center.z + sin(a) * WALL_RING) == -INF
	var step := WALL_STEP / WALL_RING
	for k in roads.size():
		var a: float = roads[k]
		if dry.call(a):
			_building(root, style + "_gate", Vector3(cos(a), 0.0, sin(a)) * WALL_RING, a, false, VIEW_WALLS)
			for s: float in [-1.0, 1.0]:  # the gate's pillars are solid; the road between them is open
				var post := a + s * 5.6 / WALL_RING
				_solid_box(root, Vector3(cos(post), 0.0, sin(post)) * WALL_RING, Vector3(2.4, 7.0, 2.4), post)
		spots.gates.append(Vector3(cos(a), 0.0, sin(a)) * GATE_RING)
		var width: float = fposmod(float(roads[(k + 1) % roads.size()]) - a, TAU) - 2.0 * 8.0 / WALL_RING
		var sections := int(width / step)
		for n in sections:
			var at := a + 8.0 / WALL_RING + (n + 0.5) * width / sections
			if n % 4 == 3 or not dry.call(at):
				continue
			if n % 4 == 0:
				_building(root, style + "_tower", Vector3(cos(at), 0.0, sin(at)) * WALL_RING, at, true, VIEW_WALLS)
			else:
				_building(root, style + "_wall", Vector3(cos(at), 0.0, sin(at)) * WALL_RING, at, true, VIEW_WALLS)


## The valley's roads as packed dirt laid on the ground (user, 2026-11-09: easier to see): a
## worn middle, darker wheel ruts and grassy edges, following the land a little above it.
const ROAD_DIRT := Color(0.47, 0.36, 0.24)
const ROAD_RUT := Color(0.33, 0.25, 0.17)
const ROAD_EDGE := Color(0.4, 0.38, 0.22)


func _build_roads() -> void:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var half := ValleyTerrain.ROAD_WIDTH * 0.5
	# Strips across the road: their edges as fractions of the half width, and each strip's color.
	var edges := [-1.25, -0.85, -0.55, -0.35, 0.35, 0.55, 0.85, 1.25]
	var colors := [ROAD_EDGE, ROAD_DIRT, ROAD_RUT, ROAD_DIRT, ROAD_RUT, ROAD_DIRT, ROAD_EDGE]
	for road in terrain.roads:
		var line: PackedVector2Array = road.line
		var points: Array = []  # every 2 m along the road
		for i in line.size() - 1:
			var n := maxi(1, int(line[i].distance_to(line[i + 1]) / 2.0))
			for k in n:
				points.append(line[i].lerp(line[i + 1], float(k) / n))
		points.append(line[line.size() - 1])
		var rows: Array = []  # each point's strip edges on the ground, shared by the segments on both sides
		for i in points.size():
			var p: Vector2 = points[i]
			var side := ((points[mini(i + 1, points.size() - 1)] as Vector2) - (points[maxi(i - 1, 0)] as Vector2)).orthogonal().normalized() * half
			var row: Array = []
			for f: float in edges:
				var q := p + side * f
				row.append(Vector3(q.x, terrain.height(q.x, q.y) + 0.16, q.y))
			rows.append(row)
		for i in points.size() - 1:
			var a: Vector2 = points[i]
			var b: Vector2 = points[i + 1]
			if terrain.near_bridge(a.x, a.y, 6.0) or terrain.water_surface(a.x, a.y) != -INF or terrain.water_surface(b.x, b.y) != -INF:
				continue  # the bridge is its own road
			for k in colors.size():
				_quad(st, rows[i][k], rows[i + 1][k], rows[i + 1][k + 1], rows[i][k + 1], colors[k])
	st.generate_normals()
	var mesh := MeshInstance3D.new()
	mesh.name = "Roads"
	mesh.mesh = st.commit()
	var mat := StandardMaterial3D.new()
	mat.vertex_color_use_as_albedo = true
	mat.vertex_color_is_srgb = true
	mat.roughness = 1.0
	RetroLook.paint(mat, true)
	mesh.material_override = mat
	mesh.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	add_child(mesh)


## A dirt road from the square to each gate, two lanes around the town, and the square itself:
## one flat mesh on the village's level ground.
func _build_streets(root: Node3D, roads: Array) -> void:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var ring := func(r: float, half: float, color: Color, y: float) -> void:
		var inner: float = maxf(r - half, 0.0)
		for i in 40:
			var a0 := TAU * i / 40.0
			var a1 := TAU * (i + 1) / 40.0
			var d0 := Vector3(cos(a0), 0.0, sin(a0))
			var d1 := Vector3(cos(a1), 0.0, sin(a1))
			_quad(st, d0 * inner + Vector3.UP * y, d0 * (r + half) + Vector3.UP * y, d1 * (r + half) + Vector3.UP * y, d1 * inner + Vector3.UP * y, color)
	ring.call(6.5, 6.5, SQUARE_COLOR, 0.1)
	ring.call(26.0, 1.6, ROAD_COLOR, 0.07)
	ring.call(38.5, 1.6, ROAD_COLOR, 0.07)
	ring.call(53.5, 1.4, ROAD_COLOR, 0.07)
	for a: float in roads:
		var d := Vector3(cos(a), 0.0, sin(a))
		var side := Vector3(-d.z, 0.0, d.x) * 2.6
		var y := Vector3.UP * 0.08
		_quad(st, d * 12.0 - side + y, d * 76.0 - side + y, d * 76.0 + side + y, d * 12.0 + side + y, ROAD_COLOR)
	st.generate_normals()
	var mesh := MeshInstance3D.new()
	mesh.name = "Streets"
	mesh.mesh = st.commit()
	var mat := StandardMaterial3D.new()
	mat.vertex_color_use_as_albedo = true
	mat.vertex_color_is_srgb = true
	mat.roughness = 1.0
	RetroLook.paint(mat, true)
	mesh.material_override = mat
	mesh.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	root.add_child(mesh)


## Facing up whichever way the corners run (Godot's front faces wind clockwise).
static func _quad(st: SurfaceTool, a: Vector3, b: Vector3, c: Vector3, d: Vector3, color: Color) -> void:
	var flip := (b - a).cross(c - a).y > 0.0
	for p in ([a, b, c, a, c, d] if not flip else [a, c, b, a, d, c]):
		st.set_color(color)
		st.add_vertex(p)


func _solid_box(root: Node3D, at: Vector3, size: Vector3, angle: float) -> void:
	var shape := CollisionShape3D.new()
	var bs := BoxShape3D.new()
	bs.size = size
	shape.shape = bs
	shape.position = root.position + at + Vector3.UP * size.y * 0.5
	shape.rotation.y = -angle - PI * 0.5
	_solid.add_child(shape)


## A riverside hamlet: a few houses facing the water, a jetty out over it,
## fishing clutter and a sign. `to_water` points from the center to the water.
func build_hamlet(center: Vector3, to_water: Vector2, title: String, race := "") -> Node3D:
	var root := Node3D.new()
	root.name = "Hamlet_" + title.replace(" ", "_")
	add_child(root)
	root.position = center
	var facing := atan2(to_water.y, to_water.x)
	# Houses in an arc on the land side, their doors toward the water.
	for i in 3:
		var a := facing + PI + (i - 1) * 0.75
		_building(root, _kit(race)[(i + 1) % 3], Vector3(cos(a), 0.0, sin(a)) * 16.0, a, true)
	for i in 4:
		var a := facing + (i - 1.5) * 0.6
		_building(root, ["barrel", "crate", "barrel", "cart"][i], Vector3(cos(a), 0.0, sin(a)) * 9.0, _rng.randf() * TAU, false)
	_building(root, "well", Vector3.ZERO, 0.0, false)
	_build_jetty(Vector2(center.x, center.z), to_water)
	var sign := Label3D.new()
	sign.name = "Sign"
	sign.text = title
	sign.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	sign.font_size = 64
	sign.outline_size = 16
	sign.pixel_size = 0.02
	sign.modulate = Color(0.75, 0.9, 1.0)
	sign.position = Vector3.UP * 12.0
	root.add_child(sign)
	return root


## A wooden jetty from the shore out over the water (walkable).
func _build_jetty(from: Vector2, dir: Vector2) -> void:
	var d := 0.0
	while d < 120.0 and terrain.height(from.x + dir.x * d, from.y + dir.y * d) > ValleyTerrain.WATER_Y + 0.4:
		d += 1.0
	var shore := from + dir * (d - 4.0)
	var tip := from + dir * (d + 12.0)
	var y := ValleyTerrain.WATER_Y + 0.7
	var a3 := Vector3(shore.x, maxf(y, terrain.height(shore.x, shore.y) + 0.1), shore.y)
	var b3 := Vector3(tip.x, y, tip.y)
	var root := Node3D.new()
	root.name = "Jetty"
	add_child(root)
	var wood := StandardMaterial3D.new()
	wood.albedo_color = Color(0.5, 0.36, 0.22)
	wood.roughness = 0.9
	var length := a3.distance_to(b3)
	var along := Transform3D(Basis.looking_at(b3 - a3, Vector3.UP), (a3 + b3) * 0.5)
	_bridge_box(root, along, Vector3(0, -0.2, 0), Vector3(3.0, 0.4, length), wood)
	for k in 3:
		for side in [-1.0, 1.0]:
			var top := along * Vector3(side * 1.3, 0.0, -length * 0.5 + length * (k + 1) / 3.0)
			var post := MeshInstance3D.new()
			var box := BoxMesh.new()
			box.size = Vector3(0.3, 4.0, 0.3)
			post.mesh = box
			post.material_override = wood
			root.add_child(post)
			post.global_transform = Transform3D(Basis(), top - Vector3(0, 1.6, 0))


## Tints a village purple (taken by Count Fuckula).
static func corrupt_village(root: Node3D) -> void:
	var overlay := StandardMaterial3D.new()
	overlay.albedo_color = Color(0.3, 0.05, 0.4, 0.45)
	overlay.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	overlay.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	for m in root.find_children("*", "MeshInstance3D", true, false):
		if not _in_character(m, root):  # characters tint themselves
			(m as MeshInstance3D).material_overlay = overlay
	var fire := root.get_node_or_null("Fire") as OmniLight3D
	if fire != null:
		fire.light_color = Color(0.7, 0.3, 1.0)


## Your village after Count Fuckula's raid (user, 2026-11-08: the opening): every other house
## of the rings is a charred wreck, blackened, slumped and leaning. Stays so for the run.
static func burn_village(root: Node3D) -> void:
	if root == null or root.has_meta("burned"):
		return
	root.set_meta("burned", true)
	var soot := StandardMaterial3D.new()
	soot.albedo_color = Color(0.05, 0.04, 0.035, 0.75)
	soot.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	for h in _burnable(root):
		h.set_meta("burned", true)
		for m in h.find_children("*", "MeshInstance3D", true, false):
			(m as MeshInstance3D).material_overlay = soot
		h.position.y -= 1.2  # slumped into its ashes
		h.rotation.x += 0.12
		h.rotation.z -= 0.08


## Where the burned houses stand (world), for the flames.
static func burned_spots(root: Node3D) -> Array:
	return _burnable(root).filter(func(h): return h.has_meta("burned")).map(func(h): return h.global_position + Vector3.UP * 2.0)


## The houses of the rings (not the walls, the bonfire or the clutter), every other one.
static func _burnable(root: Node3D) -> Array:
	var out: Array = []
	var k := 0
	for n in root.get_children():
		var r := Vector2((n as Node3D).position.x, (n as Node3D).position.z).length() if n is Node3D else 0.0
		if r > INNER_RING - 3.0 and r < OUTER_RING + 4.0 and not n.get_children().any(func(c): return c is Breakable and c.kind != "building"):  # props, not houses
			if k % 2 == 0:
				out.append(n)
			k += 1
	return out


static func _in_character(node: Node, top: Node) -> bool:
	var cur := node.get_parent()
	while cur != null and cur != top:
		if cur is CharacterModel:
			return true
		cur = cur.get_parent()
	return false


## A village model facing the center, with a box collider if `solid`.
## `breakable`: a wooden prop shatters when hit (Breakable); not a caravan's cart, which travels.
func _building(root: Node3D, model: String, at: Vector3, angle: float, solid: bool, view := 0.0, breakable := true) -> void:
	var path := VILLAGE + model + ".glb"
	if not ResourceLoader.exists(path):
		return
	var n: Node3D = (load(path) as PackedScene).instantiate()
	root.add_child(n)
	CharacterModel.use_vertex_colors(n)
	n.position = at
	n.rotation.y = -angle - PI * 0.5
	var grow := BUILDING_GROWTH if solid and not (model.contains("wall") or model.contains("tower") or model.contains("gate")) else 1.0
	n.scale = Vector3.ONE * VILLAGE_SCALE * grow
	if view > 0.0:  # many small parts: only near ones are drawn
		for m in n.find_children("*", "MeshInstance3D", true, false):
			(m as MeshInstance3D).visibility_range_end = view
	if not solid:
		if breakable:
			Breakable.attach(n, model)
		return
	var box := AABB()
	var first := true
	for m in n.find_children("*", "MeshInstance3D", true, false):
		var b: AABB = local_transform(m, n) * (m as MeshInstance3D).get_aabb()
		box = b if first else box.merge(b)
		first = false
	var shape := CollisionShape3D.new()
	var bs := BoxShape3D.new()
	bs.size = box.size * VILLAGE_SCALE * grow * Vector3(0.9, 1.0, 0.9)
	shape.shape = bs
	shape.position = root.position + at + Vector3.UP * bs.size.y * 0.5
	shape.rotation.y = n.rotation.y
	_solid.add_child(shape)
	if model.contains("wall") or model.contains("tower"):
		occlude(n)
	if breakable:
		Breakable.attach_building(n, shape, bs.size)


## Occlusion culling (docs/PERFORMANCE_PLAN.md, a contained try): the model's own triangles become an
## occluder, so whatever stands fully behind it is not drawn. Freed with the model when it breaks.
## shortcut: occluders have no visibility range, so a wall faded out past VIEW_WALLS still hides what is
## behind it (deep in the fog there); add a distance check if far things visibly pop.
static func occlude(n: Node3D) -> void:
	for m: MeshInstance3D in n.find_children("*", "MeshInstance3D", true, false):
		var verts := PackedVector3Array()
		var idx := PackedInt32Array()
		for s in m.mesh.get_surface_count():
			var arr := m.mesh.surface_get_arrays(s)
			var base := verts.size()
			var v: PackedVector3Array = arr[Mesh.ARRAY_VERTEX]
			verts.append_array(v)
			var ix: PackedInt32Array = arr[Mesh.ARRAY_INDEX] if arr[Mesh.ARRAY_INDEX] != null else PackedInt32Array(range(v.size()))
			for i in ix:
				idx.append(base + i)
		var shape := ArrayOccluder3D.new()
		shape.set_arrays(verts, idx)
		var occ := OccluderInstance3D.new()
		occ.occluder = shape
		m.add_child(occ)
