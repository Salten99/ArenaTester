; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Arena Game"
config/description="Mythical gladiator arena horde fighter: endless survival, built to tune movement and combat feel."
run/main_scene="res://scenes/start_menu.tscn"
config/features=PackedStringArray("4.7")

[autoload]

GameData="*res://scripts/autoload/game_data.gd"
RunRng="*res://scripts/autoload/run_rng.gd"
HitStop="*res://scripts/autoload/hit_stop.gd"
Controls="*res://scripts/autoload/controls.gd"
Combat="*res://scripts/autoload/combat.gd"
Run="*res://scripts/autoload/run.gd"
Flow="*res://scripts/autoload/flow.gd"
Playtest="*res://scripts/autoload/playtest.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
environment/ssao/quality=3
anti_aliasing/quality/msaa_3d=2
occlusion_culling/use_occlusion_culling=true
